# Build outputs
build/
dist/
# Xcode derived data from a local `xcodebuild -derivedDataPath` run. Bare
# `build/` above does NOT match these — the suffix makes them distinct names,
# and a single simulator build is ~4 GB.
apps/mobile/ios/build-*/

# Turbo
.turbo/

# OS
.DS_Store
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# Editor
.vscode/
.idea/
*.swp
*.swo

# TypeScript
*.tsbuildinfo

# Git worktrees (superpowers subagent-driven-development isolation)
.worktrees/

# Session working files — seed undo manifests, generator scripts, scratch data.
# Never deliverables, and seeded-log-ids.json is the only way to clean up a
# seeded account, so it must not be shared or overwritten via git.
scratchpad/

# Deno lockfile for the edge functions — deliberately NOT committed.
# `supabase functions deploy` does not use it: the deployed runtime resolves the
# npm:/jsr: specifiers itself, and 50 of those imports carry no version. Pinning
# CI to a lockfile would make CI green against versions prod is not running, so
# the type-check would stop being an early warning that the next upstream
# release breaks a live function. Commit this file once the specifiers
# themselves are pinned — at that point the lock and the deploy agree.
supabase/functions/deno.lock
